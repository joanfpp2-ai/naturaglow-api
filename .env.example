# Copiar a .env y cambiar los valores (scripts/setup-vm.sh lo genera solo con claves aleatorias)

# Puerto publico de la API en la VM (abrirlo en el NSG de Azure)
API_PORT=3000

# Clave que Postman debe enviar en la cabecera x-api-key
API_KEY=12367

# Usuario administrador de MongoDB (solo para administrar, la API NO lo usa)
MONGO_ROOT_USER=ng_root
MONGO_ROOT_PASSWORD=12367

# Usuario de la aplicacion: solo readWrite sobre NATURAGLOW_DB (minimo privilegio)
MONGO_APP_USER=ng_api
MONGO_APP_PASSWORD=12367

# Origen permitido por CORS (la URL de la capa de presentacion). * = cualquiera
CORS_ORIGIN=*
